{
  "id": "hyprfocus",
  "name": "hyprfocus",
  "namespace": "plugin:hyprfocus",
  "luaNamespace": "hyprfocus",
  "label": "Hyprfocus Window Flash",
  "icon": "flare",
  "description": "Briefly highlights or animates windows when they receive keyboard focus (Flashfocus for Hyprland).",
  "repository": "https://github.com/hyprwm/hyprland-plugins/tree/main/hyprfocus",
  "sections": [
    {
      "id": "general",
      "label": "General Focus Settings",
      "options": [
        {
          "key": "plugin:hyprfocus:enabled",
          "luaKey": "enabled",
          "label": "Enable Hyprfocus",
          "description": "Enable focus transition animations on active window change.",
          "type": "bool",
          "default": true
        },
        {
          "key": "plugin:hyprfocus:animate_workspace_change",
          "luaKey": "animate_workspace_change",
          "label": "Animate On Workspace Switch",
          "description": "Trigger focus flash when switching workspaces.",
          "type": "bool",
          "default": true
        },
        {
          "key": "plugin:hyprfocus:animate_floating",
          "luaKey": "animate_floating",
          "label": "Animate Floating Windows",
          "description": "Apply focus flash effect to floating windows.",
          "type": "bool",
          "default": true
        },
        {
          "key": "plugin:hyprfocus:focus_animation",
          "luaKey": "focus_animation",
          "label": "Animation Style",
          "description": "Visual effect style used on window focus.",
          "type": "choice",
          "values": [
            {
              "id": "flash",
              "label": "Flash (Opacity pulse)"
            },
            {
              "id": "shrink",
              "label": "Shrink (Scale bounce)"
            }
          ],
          "default": "flash"
        }
      ]
    },
    {
      "id": "flash",
      "label": "Flash Effect Parameters",
      "options": [
        {
          "key": "plugin:hyprfocus:flash:flash_opacity",
          "luaKey": "flash.flash_opacity",
          "label": "Flash Opacity Dip",
          "description": "Minimum opacity reached during flash animation.",
          "type": "float",
          "min": 0.1,
          "max": 1.0,
          "step": 0.05,
          "default": 0.5
        },
        {
          "key": "plugin:hyprfocus:flash:in_speed",
          "luaKey": "flash.in_speed",
          "label": "Flash In Speed",
          "description": "Speed multiplier for the fade-in animation.",
          "type": "float",
          "min": 0.1,
          "max": 10.0,
          "step": 0.1,
          "default": 0.5
        },
        {
          "key": "plugin:hyprfocus:flash:out_speed",
          "luaKey": "flash.out_speed",
          "label": "Flash Out Speed",
          "description": "Speed multiplier for the fade-out animation.",
          "type": "float",
          "min": 0.1,
          "max": 10.0,
          "step": 0.1,
          "default": 3.0
        }
      ]
    }
  ]
}
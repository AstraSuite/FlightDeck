          "min": 0,
          "max": 50,
          "default": 12
        },
        {
          "key": "plugin:gloview:bg_color",
          "luaKey": "bg_color",
          "label": "Backdrop Dim Color",
          "description": "Background tint and opacity overlay.",
          "type": "color",
          "default": "rgba(000000aa)"
        },
        {
          "key": "plugin:gloview:active_border_color",
          "luaKey": "active_border_color",
          "label": "Active Window Border Color",
